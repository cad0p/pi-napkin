#!/bin/sh
# SPDX-License-Identifier: MIT
# Part of @cad0p/pi-napkin - vault-main-guard reference-transaction hook.
#
# Enforces one invariant on a shared vault's main branch:
#   refs/heads/main never moves non-fast-forward and is never deleted.
#
# Why: an auto-distill agent once pointed a local main ref at its private
# landing-branch tip with a bare `git update-ref refs/heads/main <sha>`. The
# write was message-less, ignored fast-forward-ness, left the worktree
# untouched, and dropped another session's unpushed commit. A git hook covers
# every tool and every session; steering rules only cover pi's own tool calls.
#
# Behavior (POSIX sh, silent on success):
#   * fast-forwards, merges (descendant commits) and the initial creation of
#     refs/heads/main pass;
#   * a delete (all-zero new value) is refused;
#   * any new value that is not a descendant of the current tip is refused.
#
# The current tip is resolved here with `git rev-parse` because git may pass
# an all-zero old value when the caller supplied none (plain
# `git update-ref <ref> <new>`), which would otherwise hide the tip the new
# value has to descend from.
#
# Recovery for a refused move: merge the other history into main
# (`git merge <ref>`, `git pull --no-rebase`), or put the change on a
# feature branch and merge that. Never rewrite main.
#
# Installed by extensions/distill/scripts/vault-main-guard/install.sh.
# marker: vault-main-guard

# Only the "prepared" transaction can be vetoed; "committed"/"aborted" are
# report-only states.
[ "${1-}" = prepared ] || exit 0

guard_ref=refs/heads/main

# All-zero new value means deletion. Match "only zeroes" instead of a fixed
# 40-character constant so SHA-256 repositories work too.
is_zero() {
	case "$1" in
	'' | *[!0]*) return 1 ;;
	*) return 0 ;;
	esac
}

while read -r _old new ref; do
	[ "$ref" = "$guard_ref" ] || continue

	if is_zero "$new"; then
		printf '%s\n' \
			"vault-main-guard: refusing to delete $guard_ref" \
			"The shared vault's main branch must always exist. To discard local" \
			"work, merge or revert it instead of deleting the branch." >&2
		exit 1
	fi

	# Resolve the current tip ourselves; the hook argument may be all-zero.
	cur=$(git rev-parse -q --verify "$guard_ref" 2>/dev/null) || cur=''
	# Initial creation: no current tip yet - nothing to orphan.
	[ -n "$cur" ] || continue
	# No-op / idempotent write.
	[ "$cur" = "$new" ] && continue
	if git merge-base --is-ancestor "$cur" "$new" 2>/dev/null; then
		continue
	fi

	printf '%s\n' \
		"vault-main-guard: refusing a non-fast-forward move of $guard_ref" \
		"  current tip: $cur" \
		"  new tip:     $new" \
		"The new tip is not a descendant of the current tip, so commits that" \
		"exist only on main (another session's unpushed work) would be" \
		"orphaned. Land the change with a merge instead:" \
		"  git merge <source>        (or: git pull --no-rebase)" \
		"If the other history was rewritten on purpose, inspect it on a" \
		"branch first - main is never rewritten." >&2
	exit 1
done

exit 0
